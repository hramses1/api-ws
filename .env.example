# Port the API listens on
PORT=3000

# API key required in the `x-api-key` header for every endpoint except
# /status and /health. Leave empty in dev to disable auth (a warning is logged).
# Use a strong value (>= 16 chars) in production.
API_KEY=

# Optional: forward incoming messages to this HTTP endpoint (POST JSON).
# Leave empty to disable webhooks.
WEBHOOK_URL=

# Optional: if set, webhook payloads are signed with HMAC-SHA256 and the
# signature is sent in the `x-webhook-signature` header.
WEBHOOK_SECRET=

# How many WhatsApp operations may hit the browser at once. This is what makes
# bulk sending parallel; raising it too far saturates Chrome. Integer 1..20.
WWEB_MAX_CONCURRENCY=5

# Per-operation timeout. A slower operation fails with 504 instead of hanging
# the request. Integer 1000..120000.
WWEB_OP_TIMEOUT_MS=30000

# Hard cap on recipients per bulk call. Integer 1..100. Keep it low: WhatsApp
# bans numbers that blast many recipients who never wrote first.
WWEB_BULK_MAX_RECIPIENTS=50

# Global rate limit per IP: THROTTLE_LIMIT requests per THROTTLE_TTL ms.
# Defaults 30/60000. Raise only for local testing — the limit exists to keep
# WhatsApp from flagging the account.
THROTTLE_TTL=60000
THROTTLE_LIMIT=30
